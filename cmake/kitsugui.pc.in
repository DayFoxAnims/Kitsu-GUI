prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: KitsuGui
Description: A C++ GUI library built on top of SDL2
Version: @PROJECT_VERSION@
Requires: sdl2 SDL2_ttf SDL2_gfx SDL2_image
Libs: -L${libdir} -lkitsugui
Cflags: -I${includedir}
